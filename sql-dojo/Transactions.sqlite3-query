SELECT * FROM transactions;
SELECT description, amount
FROM transactions
WHERE type='expense'
ORDER BY amount DESC;

SELECT COUNT(*)
FROM transactions
WHERE type='income';

SELECT SUM(amount)
FROM transactions
WHERE type='expense';

SELECT type, COUNT(*), SUM(amount)
FROM transactions
GROUP BY type;

